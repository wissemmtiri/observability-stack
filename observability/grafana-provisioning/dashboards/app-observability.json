{
  "title": "App Observability (API + Worker)",
  "uid": "app-observability",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": { "text": "Loki", "value": "Loki" }
      },
      {
        "name": "api_route",
        "type": "query",
        "datasource": "${datasource}",
        "label": "API Route",
        "query": "label_values(http_requests_total, route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": "Prometheus",
        "label": "Queue",
        "query": "label_values(rabbitmq_queue_messages_ready, queue)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "orders", "value": "orders" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "API req/s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "all"
        }
      ]
    },
    {
      "type": "stat",
      "title": "API error rate (%)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "100 * (sum(rate(http_requests_total{status!~\"OK|Created|Accepted\"}[$__rate_interval])) / sum(rate(http_requests_total[$__rate_interval])))",
          "legendFormat": "error %"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "timeseries",
      "title": "API p95 latency (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{route=~\"$api_route\"}[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker jobs/s (success vs fail)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum by (result) (rate(worker_jobs_processed_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Worker p95 duration (s)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(worker_job_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "E2E p95 (s)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_e2e_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "E2E p99 (s)",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(order_e2e_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "E2E current p95 (s)",
      "gridPos": { "x": 0, "y": 28, "w": 6, "h": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(order_e2e_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    },
    {
      "type": "heatmap",
      "title": "E2E latency distribution (s)",
      "gridPos": { "x": 6, "y": 28, "w": 12, "h": 8 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum by (le) (rate(order_e2e_duration_seconds_bucket[$__rate_interval]))",
          "format": "heatmap"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": { "legend": { "show": true } }
    },
    {
      "type": "timeseries",
      "title": "E2E throughput (jobs/s)",
      "gridPos": { "x": 18, "y": 28, "w": 6, "h": 4 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(worker_jobs_processed_total[$__rate_interval]))",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Recent API errors (Loki)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": "${loki}",
      "options": { "showTime": true, "dedupStrategy": "none" },
      "targets": [
        {
          "expr": "{app=\"api\"} |= \"error\""
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ — Queue depth (ready)",
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"$queue\"}",
          "legendFormat": "ready"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ — Unacked messages",
      "gridPos": { "x": 8, "y": 36, "w": 8, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_unacked{queue=\"$queue\"}",
          "legendFormat": "unacked"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" } }
    },
    {
      "type": "stat",
      "title": "RabbitMQ — Consumers",
      "gridPos": { "x": 16, "y": 36, "w": 8, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rabbitmq_queue_consumers{queue=\"$queue\"}",
          "legendFormat": "consumers"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ — Publish vs Deliver (msgs/s)",
      "gridPos": { "x": 0, "y": 42, "w": 16, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_exchange_messages_published_total[5m]))",
          "legendFormat": "published"
        },
        {
          "expr": "sum(rate(rabbitmq_queue_messages_delivered_total{queue=\"$queue\"}[5m]))",
          "legendFormat": "delivered ($queue)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ — Backlog drain time (s)",
      "gridPos": { "x": 16, "y": 42, "w": 8, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"$queue\"} / clamp_min(sum(rate(rabbitmq_queue_messages_delivered_total{queue=\"$queue\"}[5m])), 0.001)",
          "legendFormat": "ETA to empty ($queue)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1 } }
    },
    {
      "type": "timeseries",
      "title": "RabbitMQ — Requeued / Dropped (msgs/s)",
      "gridPos": { "x": 0, "y": 48, "w": 12, "h": 6 },
      "datasource": "${datasource}",
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_queue_messages_requeued_total{queue=\"$queue\"}[5m]))",
          "legendFormat": "requeued"
        },
        {
          "expr": "sum(rate(rabbitmq_queue_messages_dropped_total{queue=\"$queue\"}[5m]))",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ]
}
